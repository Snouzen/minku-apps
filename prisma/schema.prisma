generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  role      Role     @default(PIC)
  picName   String?  @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]

  @@map("users")
}

model Task {
  id          Int      @id @default(autoincrement())
  inputDate   DateTime @default(now())
  task        String
  dueDate     DateTime
  pic         String[]
  status      Status   @default(OPEN)
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById Int?

  @@map("tasks")
}

enum Role {
  SUPER_ADMIN
  PIC
}

enum Status {
  OPEN
  IN_PROGRESS
  DONE
  ALMOST_EXPIRED
}

model UbiMaintenance {
  id                      Int       @id @default(autoincrement())
  status                  UbiStatus @default(INISIASI)
  kegiatan                String
  site                    String
  nominalPengajuan        Float?
  progress                String?
  nominalHasilEvaluasi    Float?
  nominalRealisasi        Float?
  dependency              UbiDependency?

  sdiPengajuanRm          String?
  ndIzinPrinsipGm         String?
  ndIzinPrinsipDirsar     String?
  ndIzinPenggunaanRka     String?
  ndBalasanDivisiUmum     String?
  sdiPemberitahuanRm      String?
  ndPermohonanPembayaran  String?
  batasPenerbitanKontrak  DateTime?
  dokumentasiUrls         String[]

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?

  @@map("ubi_maintenances")
}

enum UbiStatus {
  INISIASI
  SEDANG_BERLANGSUNG
  SELESAI
}

enum UbiDependency {
  MINKU
  OPERASIONAL
}

model UnitProduksi {
  idRegional    String   @id @default(cuid())
  namaRegional  String
  siteArea      String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  alamat        String?  @default("")
  kodeRegional  String?

  @@map("unit_produksi")
}
