generator client {
  provider   = "prisma-client-js"
  engineType = "binary"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  role      Role     @default(PIC)
  jabatan   String?  // e.g. "Manager", "Asman", "Staff", "Guest"
  picName   String?  @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tasks     Task[]
  matrixTasks MatrixTask[]
  subTasksCreated MatrixSubTask[] @relation("SubTaskCreator")
  subTaskComments SubTaskComment[]
  notificationsReceived Notification[] @relation("UserNotifications")
  notificationsSent     Notification[] @relation("NotificationSender")

  @@map("users")
}

model Task {
  id          Int      @id @default(autoincrement())
  inputDate   DateTime @default(now())
  task        String
  dueDate     DateTime
  pic         String[]
  status      Status   @default(OPEN)
  remarks     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
  createdBy   User?    @relation(fields: [createdById], references: [id])
  createdById Int?

  @@map("tasks")
}

enum Role {
  SUPER_ADMIN
  PIC
  GUEST
}

enum Status {
  OPEN
  IN_PROGRESS
  DONE
  ALMOST_EXPIRED
}

model UbiAdministrasi {
  id                      Int             @id @default(autoincrement())
  status                  UbiStatus       @default(INISIASI)
  dependency              UbiDependency?
  vendorId                Int?
  vendor                  Vendor?         @relation(fields: [vendorId], references: [id])
  nominalHasilEvaluasi    Float?
  nominalRealisasi        Float?

  ndIzinPrinsipGm         String?
  ndIzinPrinsipGmUrl      String?
  ndIzinPrinsipDirsar     String?
  ndIzinPrinsipDirsarUrl  String?
  ndIzinPenggunaanRka     String?
  ndIzinPenggunaanRkaUrl  String?
  ndBalasanDivisiUmum     String?
  ndBalasanDivisiUmumUrl  String?
  sdiPemberitahuanRm      String?
  sdiPemberitahuanRmUrl   String?
  ndPermohonanPembayaran  String?
  ndPermohonanPembayaranUrl String?
  batasPenerbitanKontrak  DateTime?
  tanggalKontrak          DateTime?
  tanggalSelesai          DateTime?
  sumberAnggaran          SumberAnggaran?
  dokumentasiUrls         String[]

  kegiatan                UbiKegiatan[]

  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt
  deletedAt               DateTime?

  @@map("ubi_administrasi")
}

model UbiKegiatan {
  id              Int              @id @default(autoincrement())
  administrasiId  Int
  administrasi    UbiAdministrasi  @relation(fields: [administrasiId], references: [id], onDelete: Cascade)
  kegiatan        String
  site            String
  sdiPengajuanRm  String?
  sdiPengajuanRmUrl String?
  nominalPengajuan Float?
  progress        String?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@map("ubi_kegiatan")
}

enum UbiStatus {
  INISIASI
  SEDANG_BERLANGSUNG
  SELESAI
}

enum SumberAnggaran {
  DIVISI_UMUM
  DIVISI_TI
  UBI_INDUSTRI
}

enum UbiDependency {
  MINKU
  OPERASIONAL
}

model UnitProduksi {
  idRegional     String          @id @default(cuid())
  namaRegional   String
  siteArea       String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  alamat         String?         @default("")
  kodeRegional   String?
  matrixSubTasks MatrixSubTask[]

  @@map("unit_produksi")
}

model MatrixKegiatan {
  id              Int          @id @default(autoincrement())
  namaKegiatan    String
  tasks           MatrixTask[]
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("matrix_kegiatan")
}

model MatrixTask {
  id              Int          @id @default(autoincrement())
  namaTask        String
  kegiatanId      Int
  kegiatan        MatrixKegiatan @relation(fields: [kegiatanId], references: [id], onDelete: Cascade)
  subTasks        MatrixSubTask[]
  createdById     Int?
  createdBy       User?        @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("matrix_tasks")
}

model MatrixSubTask {
  id                    Int          @id @default(autoincrement())
  namaSubTask           String
  goals                 String?
  actionPlan            String?
  status                String       @default("OPEN") // OPEN, IN_PROGRESS, COMPLETED
  
  // Tracker Administrasi
  sdiPengajuanRm          String?
  sdiPengajuanRmLink      String?
  ndIzinPrinsipGm         String?
  ndIzinPrinsipGmLink     String?
  ndIzinPrinsipDirsar     String?
  ndIzinPrinsipDirsarLink String?
  ndIzinPenggunaanRka     String?
  ndIzinPenggunaanRkaLink String?
  ndBalasanDivisiUmum     String?
  ndBalasanDivisiUmumLink String?
  sdiPemberitahuanRm      String?
  sdiPemberitahuanRmLink  String?
  ndPermohonanPembayaran  String?
  ndPermohonanPembayaranLink String?
  batasPenerbitanKontrak  DateTime?
  batasPenerbitanKontrakLink String?

  unitProduksiId        String?
  unitProduksi          UnitProduksi? @relation(fields: [unitProduksiId], references: [idRegional], onDelete: SetNull)

  taskId                Int
  task                  MatrixTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdById           Int?
  createdBy             User?        @relation("SubTaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  comments              SubTaskComment[]
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  @@map("matrix_sub_tasks")
}

model Vendor {
  id         Int              @id @default(autoincrement())
  namaVendor String
  picVendor  String?
  kegiatan   UbiAdministrasi[]
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@map("vendors")
}

model SubTaskComment {
  id          Int      @id @default(autoincrement())
  subTaskId   Int
  subTask     MatrixSubTask @relation(fields: [subTaskId], references: [id], onDelete: Cascade)
  
  section     String   
  content     String
  
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  
  parentId    Int?     
  parent      SubTaskComment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies     SubTaskComment[] @relation("CommentReplies")
  
  createdAt   DateTime @default(now())

  @@map("sub_task_comments")
}

model Notification {
  id          Int      @id @default(autoincrement())
  
  userId      Int      
  user        User     @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  
  senderId    Int?     
  sender      User?    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)
  
  type        String   
  message     String   
  linkUrl     String?  
  isRead      Boolean  @default(false)
  
  createdAt   DateTime @default(now())

  @@map("notifications")
}
